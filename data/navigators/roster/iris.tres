[gd_resource type="Resource" script_class="NavigatorData" load_steps=2 format=3 uid="uid://nav_iris_05"]

[ext_resource type="Script" path="res://data/navigators/navigator_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
navigator_id = &"iris"
display_name = "Iris"
title = "Observadora del Vacío Cósmico"
specialty_desc = "Especializada en anomalías de dimensión cero. Detecta jefes ocultos, titanes y grietas dimensionales."
buff_name = "Trascendencia Cósmica"
buff_desc = "+30% Probabilidad Crítica y rastro de cometa fulgurante por 12s al interceptar la anomalía."
theme_color = Color(0.9, 0.85, 1, 1)
is_secret = true
sort_order = 5
target_type = &"anomaly"
dialogue_callouts = [
    "El tejido del cosmos se desgarra... Una entidad titánica o anomalía primordial se manifiesta.",
    "Percibo la firma del fin de los tiempos... El núcleo del vacío está marcado ante nosotros.",
    "Una presencia estelar inconmensurable aguarda en las sombras. Enlaza tus sentidos conmigo."
]
