# ==========================================
# Godot Engine 4+ GitIgnore
# ==========================================

# Godot-specific cache & imported assets (MUST be ignored)
.godot/
*.translation

# Local AI / MCP development tooling
addons/godot_ai/
.gemini/

# Mono / .NET / C# builds (if applicable)
.mono/
[Bb]in/
[Oo]bj/

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Game export / build artifacts
build/
builds/
export/
dist/
release/
*.apk
*.aab
*.exe
!AstraLauncher.exe
*.pck
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.rar
artist_pack*/
scratch/

# Crash logs and debug traces
*.log
crash_dump*

# Teamwork multi-agent artifacts
.agents/
ORIGINAL_REQUEST.md
